#!/bin/sh
# alchemos-code-theme: merge the HUD palette into VS Code's user settings.
#
# Usage: alchemos-code-theme '<json object>'
#   The object holds only "workbench.colorCustomizations",
#   "editor.tokenColorCustomizations" and "editor.semanticTokenColorCustomizations";
#   it's generated by quickshell/Theme.qml.
#   Those three keys are replaced, every other setting is kept. VS Code watches
#   settings.json, so open windows recolour without a reload.
#
# If settings.json has comments / trailing commas (JSONC), jq can't read it:
# the original is backed up to settings.json.alchemos-bak-<time> and a cleaned
# copy is merged. If even that fails, the file is left untouched.

set -u
dir=${XDG_CONFIG_HOME:-$HOME/.config}/Code/User
f=$dir/settings.json
patch=${1:?usage: alchemos-code-theme '<json>'}

[ -d "$dir" ] || exit 0                      # VS Code never run → nothing to theme
printf '%s' "$patch" | jq -e 'type == "object"' >/dev/null 2>&1 || { echo "alchemos-code-theme: bad palette JSON" >&2; exit 1; }

exec 9>"$dir/.alchemos-theme.lock"
flock 9

src=$f
[ -s "$f" ] || { printf '{}\n' > "$f.alchemos-tmp" && mv "$f.alchemos-tmp" "$f"; }
if ! jq -e 'type == "object"' "$f" >/dev/null 2>&1; then
    # JSONC → JSON: drop // and /* */ comments outside strings, then trailing commas
    python3 -I - "$f" > "$f.alchemos-clean" 2>/dev/null <<'EOF' || { rm -f "$f.alchemos-clean"; echo "alchemos-code-theme: can't parse $f, left untouched" >&2; exit 1; }
import json, re, sys

def scan(s, other):
    """Copy strings verbatim; hand everything else to other(s, i) → (text, next i)."""
    out, i, n = [], 0, len(s)
    while i < n:
        if s[i] == '"':
            j = i + 1
            while j < n and s[j] != '"':
                j += 2 if s[j] == "\\" else 1
            out.append(s[i:j + 1]); i = j + 1
        else:
            t, i = other(s, i); out.append(t)
    return "".join(out)

def comments(s, i):
    if s.startswith("//", i):
        j = s.find("\n", i); return "", len(s) if j < 0 else j
    if s.startswith("/*", i):
        j = s.find("*/", i + 2); return "", len(s) if j < 0 else j + 2
    return s[i], i + 1

def commas(s, i):
    return ("" if s[i] == "," and re.match(r",\s*[}\]]", s[i:]) else s[i]), i + 1

s = scan(scan(open(sys.argv[1], encoding="utf-8").read(), comments), commas)
json.loads(s)                          # raises → caller leaves the file alone
sys.stdout.write(s)
EOF
    jq -e 'type == "object"' "$f.alchemos-clean" >/dev/null 2>&1 || { rm -f "$f.alchemos-clean"; echo "alchemos-code-theme: can't parse $f, left untouched" >&2; exit 1; }
    cp -p "$f" "$f.alchemos-bak-$(date +%Y%m%d-%H%M%S)"
    src=$f.alchemos-clean
fi

jq --indent 2 --argjson p "$patch" \
    '. + ($p | {"workbench.colorCustomizations", "editor.tokenColorCustomizations", "editor.semanticTokenColorCustomizations"})' \
    "$src" > "$f.alchemos-tmp" \
  && jq -e 'type == "object"' "$f.alchemos-tmp" >/dev/null \
  && mv "$f.alchemos-tmp" "$f"
status=$?
rm -f "$f.alchemos-tmp" "$f.alchemos-clean"
exit $status
