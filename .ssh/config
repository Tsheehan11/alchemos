# UWaterloo CS student servers (Ubuntu 24.04).
#   ssh uwcs          → linux.student.cs.uwaterloo.ca (load-balanced across the hosts below)
#   ssh uwcs-002 …    → one specific host, if uwcs lands on one that's down
# Key login needs no Duo, even off campus. Password login from off campus does
# (teaching-domain password + Duo). Only the public key is installed on the
# server; the private key never leaves ~/.ssh and isn't in the dotfiles repo.

Host uwcs
    HostName linux.student.cs.uwaterloo.ca

Host uwcs-002
    HostName ubuntu2404-002.student.cs.uwaterloo.ca
Host uwcs-004
    HostName ubuntu2404-004.student.cs.uwaterloo.ca
Host uwcs-006
    HostName ubuntu2404-006.student.cs.uwaterloo.ca
Host uwcs-008
    HostName ubuntu2404-008.student.cs.uwaterloo.ca
Host uwcs-010
    HostName ubuntu2404-010.student.cs.uwaterloo.ca
Host uwcs-012
    HostName ubuntu2404-012.student.cs.uwaterloo.ca

Host uwcs uwcs-*
    User tvsheeha
    IdentityFile ~/.ssh/uw_cs_ed25519
    IdentitiesOnly yes
    # gnome-keyring's agent (gcr-ssh-agent.socket): the keyring remembers the passphrase
    IdentityAgent ${XDG_RUNTIME_DIR}/gcr/ssh
    AddKeysToAgent yes
    ServerAliveInterval 60
    # One login (and one Duo, on password logins) covers every VS Code connection
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 4h
    # Fails in seconds with a "turn on SCHOOL" hint instead of hanging
    ProxyCommand ~/.local/bin/alchemos-uwcs-proxy %h %p
