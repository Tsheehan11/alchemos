// Writes ~/.config/hypr/hypridle.conf from the timings in Settings → System,
// then restarts hypridle so they apply straight away.
pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io

Singleton {
    id: root

    readonly property var opts: [0, 1, 2, 3, 5, 10, 15, 20, 30, 45, 60, 90]   // minutes, 0 = never
    function label(m) { return m === 0 ? "NEVER" : (m < 60 ? m + " MIN" : (m / 60) + " H"); }
    function step(cur, dir) {
        let i = root.opts.indexOf(cur);
        if (i < 0) i = 0;
        return root.opts[Math.max(0, Math.min(root.opts.length - 1, i + dir))];
    }

    function config() {
        const c = Theme.cfg;
        let s = "# STARK OS — idle & sleep. Generated by Settings → System; edits here get overwritten.\n\n";
        s += "general {\n";
        s += "    lock_cmd = ~/.config/hypr/alchemos-lock.sh\n";
        s += "    before_sleep_cmd = loginctl lock-session\n";
        s += "    after_sleep_cmd = ~/.config/hypr/alchemos-dpms.sh on\n";
        s += "    ignore_dbus_inhibit = false\n";
        s += "    inhibit_sleep = 3          # don't sleep until the lock screen is really up\n";
        s += "}\n\n";
        if (c.idleDim > 0)
            s += "listener {\n    timeout = " + c.idleDim * 60 + "\n    on-timeout = brightnessctl -s set 15%\n    on-resume = brightnessctl -r\n}\n\n";
        if (c.idleLock > 0)
            s += "listener {\n    timeout = " + c.idleLock * 60 + "\n    on-timeout = loginctl lock-session\n}\n\n";
        if (c.idleScreenOff > 0)
            s += "listener {\n    timeout = " + c.idleScreenOff * 60 + "\n    on-timeout = ~/.config/hypr/alchemos-dpms.sh off\n    on-resume = ~/.config/hypr/alchemos-dpms.sh on\n}\n\n";
        if (c.idleSleep > 0)
            s += "listener {\n    timeout = " + c.idleSleep * 60 + "\n    on-timeout = ~/.local/bin/alchemos-govee suspend\n}\n";
        return s;
    }

    FileView {
        id: out
        path: Quickshell.env("HOME") + "/.config/hypr/hypridle.conf"
        blockLoading: false
        printErrors: false
    }

    function apply() {
        out.setText(root.config());
        Quickshell.execDetached(["sh", "-c", "pkill -x hypridle; sleep 0.4; setsid hypridle >/dev/null 2>&1 &"]);
    }

    // Re-write when a timing changes (not on startup, so a hand-edited file is left alone)
    property bool ready: false
    Component.onCompleted: readyTimer.start()
    Timer { id: readyTimer; interval: 3000; onTriggered: root.ready = true }
    Timer { id: debounce; interval: 600; onTriggered: root.apply() }
    Connections {
        target: Theme.cfg
        function onIdleDimChanged() { if (root.ready) debounce.restart(); }
        function onIdleLockChanged() { if (root.ready) debounce.restart(); }
        function onIdleScreenOffChanged() { if (root.ready) debounce.restart(); }
        function onIdleSleepChanged() { if (root.ready) debounce.restart(); }
    }
}
