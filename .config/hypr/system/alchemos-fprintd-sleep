#!/bin/sh
# STARK OS: bring the Elan reader back when it wedges on resume, without ever pulling
# fprintd out from under the lock screen.
# libfprint's Elan MOC driver sometimes wedges across suspend (fpi_ssm_mark_failed:
# machine != NULL, or "Cannot run while suspended" after wake) and only a USB reset of
# the sensor clears it. hyprlock claims the reader once when it starts and keeps that
# claim across suspend, so killing or restarting fprintd while hyprlock runs leaves it
# with "Device was not claimed" and no fingerprint until the next lock. So fprintd is
# never touched before sleep (fprintd and hyprlock both handle PrepareForSleep), and a
# wedge found after wake is only reset once no hyprlock is running. The password works
# throughout, and fingerprint errors never reach PAM / faillock.
# Neither half may hold up the suspend or the wake: post hands everything to a
# background unit that runs after the suspend.
ELAN="04f3:0c88"   # lsusb ID of "Elan MOC Sensors"
WEDGED='machine != NULL|Cannot run while suspended'

case "$1" in
  post)
    systemd-run --quiet --no-block --collect --unit=alchemos-fprintd-wake \
      --property=After="systemd-$2.service" -- "$0" wake "$(date +%s)"
    ;;
  wake)
    # $2: when the system woke. hyprlock (if up) restarts its scan now; without it,
    # starting fprintd opens the sensor. Either shows a wedge within a few seconds.
    resumed=$2
    pidof hyprlock >/dev/null || systemctl start fprintd.service
    timeout 8 journalctl -u fprintd --since "@$resumed" -f -o cat 2>/dev/null \
      | grep -q -m1 -E "$WEDGED" || exit 0

    echo "sensor wedged after resume; resetting it once the lock screen is gone"
    # ...and not while the system is going back to sleep (lid shut again right after the
    # unlock): a reset during suspend entry doesn't take, and the reader stays wedged.
    preparing() {
        busctl get-property org.freedesktop.login1 /org/freedesktop/login1 \
            org.freedesktop.login1.Manager PreparingForSleep 2>/dev/null | grep -q true
    }
    while pidof hyprlock >/dev/null || preparing; do sleep 2; done
    sleep 2   # after a wake, give hyprlock (lid lock) a moment to come up first
    while pidof hyprlock >/dev/null || preparing; do sleep 2; done
    # A USB reset alone often isn't enough (the sensor stays powered): alchemos-fprint-reset
    # escalates up to switching the port's power off and on, testing after each step.
    if [ -x /usr/local/bin/alchemos-fprint-reset ]; then
        /usr/local/bin/alchemos-fprint-reset --auto
        exit 0
    fi
    systemctl kill --signal=SIGKILL fprintd.service 2>/dev/null
    systemctl stop fprintd.service
    systemctl reset-failed fprintd.service 2>/dev/null
    usbreset "$ELAN" >/dev/null 2>&1
    sleep 1
    systemctl start fprintd.service
    echo "sensor reset"
    ;;
esac
exit 0
