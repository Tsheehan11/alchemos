    "warmth_db": "low shelf at 220 Hz",
    "presence_db": "peak at 2.5 kHz (SUIT centres it at 1.8 kHz via presence_hz)",
    "air_db": "high shelf at 7 kHz (negative = softer, warmer)",
    "drive_db": "light saturation; 0 = off",
    "compress": "even out loudness",
    "chorus_mix / chorus_depth": "very small values; 0 mix = off",
    "reverb_room / reverb_wet": "small-room reverb; 0 wet = off",
    "gain_db": "deliberate loudness offset in dB; 0 = as loud as every other preset (output is loudness-matched, see core/effects.py)",
