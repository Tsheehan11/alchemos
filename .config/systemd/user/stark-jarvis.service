# STARK OS: the Jarvis voice loop (~/.config/jarvis/jarvis.py), as its own user service so a
# Quickshell restart or hot reload never takes it down (a DJ set keeps playing).
#
# Not enabled: the HUD (quickshell/OrrinState.qml) starts and stops it through
# ~/.config/jarvis/stark-jarvis (linked in ~/.local/bin), which writes the session env + mode to %t/jarvis/service.env.
# Logs: journalctl --user -u stark-jarvis   (also ~/.local/share/jarvis/jarvis.log)
#
# Session end: PartOf the graphical session, the HUD stops it before log-out, and jarvis.py
# exits cleanly by itself once its Hyprland instance is gone (core/session.py).
[Unit]
Description=STARK OS Jarvis voice assistant
Documentation=file://%h/.github/README.md
PartOf=graphical-session.target
After=graphical-session.target pipewire.service wireplumber.service
# a crash loop gives up after 5 tries in 5 min; stark-jarvis start resets it
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
WorkingDirectory=%h
# WAYLAND_DISPLAY, HYPRLAND_INSTANCE_SIGNATURE, PATH… and STARK_JARVIS_LAPTOP (0 / 1)
EnvironmentFile=-%t/jarvis/service.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/.config/jarvis/.venv/bin/python %h/.config/jarvis/jarvis.py
# a crash or "microphone stream keeps ending" (exit 1) restarts it; a stop / session end doesn't
Restart=on-failure
RestartSec=5
# nothing Jarvis starts can gain privileges (no sudo / setuid helpers), as before
NoNewPrivileges=yes
# stop takes the whole cgroup: pw-record, the claude CLI, MCP servers, pw-play
KillMode=control-group
TimeoutStopSec=10
SyslogIdentifier=jarvis
