#!/bin/sh
# AlchemOS: control the Orrin voice service (~/.config/systemd/user/orrin.service).
# The HUD (quickshell/OrrinState.qml) calls this; it works from a terminal too.
#
#   orrinctl start [docked|laptop]   start it (no-op if it already runs in that mode; restarts
#                                         it if the mode differs). Default: docked.
#   orrinctl stop                    stop it (and anything left in its cgroup)
#   orrinctl restart                 restart in the current mode
#   orrinctl status                  one line: <state> <mode> <pid>   e.g. "active docked 41233"
#   orrinctl log                     follow the journal
#   orrinctl strays                  voice loops running outside the service (start / stop kill them)
#
# start writes %t/orrin/service.env from the caller's session env, so the service always has the
# right WAYLAND_DISPLAY / HYPRLAND_INSTANCE_SIGNATURE even when systemd's own env is stale.
# It also clears out a stray voice loop outside the service (an old HUD child, a hand-run
# `orrin`): only `python …/orrin.py` with no arguments, matched without matching itself.
set -u
unit=orrin.service
run="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/orrin"
envf="$run/service.env"

mode_of_env() { grep -qx 'ORRIN_LAPTOP=1' "$envf" 2>/dev/null && echo laptop || echo docked; }

status() {
    st=$(systemctl --user is-active "$unit" 2>/dev/null)
    pid=$(systemctl --user show -P MainPID "$unit" 2>/dev/null)
    echo "${st:-unknown} $(mode_of_env) ${pid:-0}"
}

# voice loops (orrin.py with no arguments: the command line ends in /orrin.py) that aren't in the service's cgroup.
# (Before the AlchemOS rename this looked for jarvis.py, so after it no stray was ever found.)
strays() {
    for p in $(pgrep -f '/[o]rrin\.py$'); do
        grep -q "/$unit\$" "/proc/$p/cgroup" 2>/dev/null || echo "$p"
    done
}

write_env() {
    mkdir -p -m 700 "$run"
    tmp="$envf.tmp"
    : >"$tmp"; chmod 600 "$tmp"
    for k in WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE \
             PATH DBUS_SESSION_BUS_ADDRESS QT_QPA_PLATFORM HYPRCURSOR_THEME HYPRCURSOR_SIZE XCURSOR_THEME XCURSOR_SIZE; do
        eval "v=\${$k:-}"
        [ -n "$v" ] && printf '%s=%s\n' "$k" "$v" >>"$tmp"
    done
    printf 'ORRIN_LAPTOP=%s\n' "$1" >>"$tmp"
    mv -f "$tmp" "$envf"
}

case "${1:-status}" in
    start)
        want="${2:-docked}"
        case "$want" in docked) flag=0 ;; laptop) flag=1 ;; *) echo "usage: orrinctl start [docked|laptop]" >&2; exit 2 ;; esac
        s=$(strays); [ -n "$s" ] && kill $s 2>/dev/null
        if systemctl --user is-active -q "$unit"; then
            if [ "$(mode_of_env)" != "$want" ]; then
                write_env "$flag"
                systemctl --user restart "$unit"
            fi
        else
            write_env "$flag"
            systemctl --user reset-failed "$unit" 2>/dev/null
            systemctl --user start "$unit"
        fi
        status ;;
    stop)
        systemctl --user stop "$unit"
        systemctl --user reset-failed "$unit" 2>/dev/null
        s=$(strays); [ -n "$s" ] && kill $s 2>/dev/null
        status ;;
    restart)
        systemctl --user restart "$unit"
        status ;;
    status)
        status ;;
    strays)                       # list them (pids), kill nothing: tests/test_service.py
        strays ;;
    log)
        exec journalctl --user -u "$unit" -f -n 50 ;;
    *)
        sed -n '2,10p' "$0" >&2; exit 2 ;;
esac
